{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH OpenCode Migrate",
  "version": "0.5.8",
  "identifier": "io.github.summerxdsss.dsh-oc-migrate",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare && npm run desktop:web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run desktop:prepare && npm run desktop:web:build",
    "frontendDist": "../desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "DSH ↔ OpenCode",
        "width": 1200,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "backgroundColor": "#171717"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/migrate-backend"
    ],
    "resources": [
      "resources/dsh-oc-migrate-plugin.tgz"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "DeepSeek Harness 与 OpenCode 双向对话迁移",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
